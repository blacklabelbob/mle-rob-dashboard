# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the example, which holds NAMES ONLY and never a value. Until 7/29 it
# was ignored, so a fresh clone got no env documentation at all — the one thing
# it is for. `npm run check:env` fails if it stops listing what the code reads.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.build-heartbeat
.vercel-DISABLED-2026-07-08/
.driver-lock

# Meeting transcript bodies — verbatim customer speech, never in git history.
# Pull them with: node scripts/fireflies-ingest.mjs   (manifest.json IS committed)
MLE Internal Meetings/transcripts/

# Real-data artifacts — never in git history (PRD-scaffolding-in-git-data-in-supabase-v1 Phase 1).
# These are pre-migration snapshots of LIVE Supabase rows: real phones, emails, quoted amounts.
# They stay on disk as the recovery path; git is not the place for them.
# Re-create any of them with: node scripts/regen-fallback.mjs   /   the 00xx apply scripts.
backups/
docs/backups/
data/network.local.json
data/crm.local.json
