# MLE ROB Dashboard — environment
#
# Copy to `.env.local` and fill only what you need. EVERY optional seam below is
# env-gated: unset means the feature reports itself unconfigured (503 / skipped /
# heuristic fallback) and nothing else changes. The whole dashboard runs on demo
# data with NONE of these set — `npm run dev:demo`.
#
# Checked by `npm run check:env` (scripts/env-manifest.mjs) and by the test
# suite: if code reads a variable that is not listed here, both fail. Add the
# name plus a one-line comment saying what happens when it is unset.

# ── Storage ───────────────────────────────────────────────────────────────────
# "file" = committed JSON in data/ (synthetic demo data; no network, no secrets).
# "supabase" = live Postgres, and then the two vars below are required.
# Rob's 2026-07-04 decision is supabase; prod runs supabase, a clean clone runs file.
STORAGE_SOURCE=file
# Supabase project → Settings → API (server-side only, never exposed to client).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# "1" reads org referral edges from the split column. Unset = merged reads
# (today's production behavior).
ORGS_SPLIT_READS=
# File-mode path overrides, both optional. Unset = ./data and ./data/crm.json.
# Used by tests and by anyone pointing a clone at a scratch dataset.
NETWORK_DATA_DIR=
CRM_DATA_PATH=

# ── Access ────────────────────────────────────────────────────────────────────
# Basic-auth gate for the deployed dashboard (user: rob). Unset = open.
# Deliberately unset on prod since 2026-07-21 (Rob); re-arming is this one var.
DASHBOARD_PASSWORD=
# Shared secret for /api/cron/* and the admin backfill routes. Unset = those
# routes refuse to run, which is the right default for a fresh clone.
CRON_SECRET=

# ── AI ────────────────────────────────────────────────────────────────────────
# Claude-powered estimator. Unset = the deterministic heuristic runs instead.
ANTHROPIC_API_KEY=

# ── Inbound webhooks (each unset → that endpoint 503s, fully inert) ───────────
# n8n Gmail / error / voice-law pipes: x-n8n-secret must match.
N8N_EMAIL_WEBHOOK_SECRET=
# AIDRE call-outcome capture: x-aidre-secret must match.
AIDRE_WEBHOOK_SECRET=
# Partner phase-completion signals (Q40): the signal gate's shared secret.
PHASE_SIGNAL_WEBHOOK_SECRET=
# Lead intake, one key per product — the presented token decides the source.
LEADS_KEY_AIDRE=
LEADS_KEY_AIVA=

# ── Voice: Vapi receptionist (unset → webhook 503s, nothing changes) ──────────
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=
# Used only by scripts/provision-vapi-assistant.mjs (one-off provisioning).
# The three below have working defaults; the API key does not.
VAPI_API_KEY=
VAPI_SERVER_URL=
VAPI_MODEL=
VAPI_MODEL_PROVIDER=

# ── Voice: Twilio dialer (any unset → routes 503, UI keeps plain tel: links) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=
# Call transcription. Unset = nothing is sent to Deepgram and no transcript rows.
DEEPGRAM_API_KEY=

# ── E-sign delivery (unset → the send is recorded as skipped, never lost) ─────
ESIGN_SENDER_WEBHOOK_URL=
ESIGN_SENDER_SECRET=
# Consumer-signer flow stays off until this is set (consumer disclosure gate).
ESIGN_CONSUMER_ENABLED=

# ── UI toggles ────────────────────────────────────────────────────────────────
# "1" mounts the dev-chat panel and opens its API. Unset = neither exists.
NEXT_PUBLIC_DEV_CHAT=
# Saved-view authorship until Phase 4 sessions land. Unset = no identity (normal).
NEXT_PUBLIC_VIEW_OWNER=
NEXT_PUBLIC_VIEW_TEAM=

# ── Scripts only ──────────────────────────────────────────────────────────────
# scripts/fireflies-ingest.mjs — meeting transcript pull. Unset = the script exits.
FIREFLIES_API_KEY=
# scripts/sync-invoice-ledger.mjs — where the contracts repo lives. All optional;
# unset = ../contracts, invoices/invoice-ledger.csv, "MyLocalEverything/contracts".
CONTRACTS_REPO_DIR=
CONTRACTS_LEDGER_PATH=
CONTRACTS_REPO_LABEL=
# npm run verify:offline — proves the demo path makes zero network calls.
# All three are set by the runner itself; you only set them by hand when
# driving the harness directly. Leave them UNSET in any .env file: a global
# NET_SENTINEL_LOG would make every node process on your machine log sockets.
# OFFLINE_PORT unset = 3199. OFFLINE_INJECT=1 plants a page that phones home,
# so the harness can be proven able to fail (expect exit 1).
OFFLINE_PORT=
OFFLINE_INJECT=
NET_SENTINEL_LOG=

# npm run transcripts:apply — loads the 13 gitignored Fireflies meeting exports
# into 0021. Unset (the default) means `--apply` REFUSES and exits 1; only
# "1" permits the write. Q71 PRD Phase 0 gates this on Rob's answer, so the
# gate lives in code rather than in a comment. `transcripts:plan` and
# `transcripts:verify` never write and never read this.
TRANSCRIPT_LOAD_APPROVED=

# Q84 — the Notion "📞 Master Meetings Database", the meeting record the CRM gets
# CHECKED against (Rob 2026-07-30: "having the Notion in place will help me confirm
# the validity of what's in the CRM"). Read by `scripts/notion-meetings-sync.mjs`
# (fills the archive, plan-by-default) and `scripts/notion-crm-check.mjs`
# (`npm run check:archive`, strictly read-only). Unset = both refuse and exit;
# neither falls back to a partial read, because half an archive compared against
# the CRM would report meetings as missing that are merely unfetched.
NOTION_API_KEY=

# npm run inventory:agents / audit:agents (Q79) — where the agent and skill files
# live. Unset = ~/.claude, which is correct on Rob's machine; it exists so the
# audit can be pointed at a fixture tree instead of the real one. The inventory
# is a snapshot of a tree OUTSIDE this repo, so pointing it elsewhere changes
# what the committed JSON means — `audit:agents` then reports STALE (exit 2)
# rather than quietly agreeing.
CLAUDE_HOME=
