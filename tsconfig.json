{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // Q90 ruling (2026-08-05): `next build` typechecks what SHIPS. Test files are not
  // shipped, and they legitimately use loose mock shapes (partial fixtures, `as` casts,
  // ProcessEnv writes) that a production typecheck should not adjudicate. They are NOT
  // untypechecked — `npm run typecheck:tests` runs them under tsconfig.test.json, so the
  // debt stays measured instead of hidden. This is deliberately not `ignoreBuildErrors`,
  // which would delete the gate for production code too.
  "exclude": ["node_modules", "**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"]
}
